# P12 / A5: SymbiYosys BMC on P2 sync_fifo
[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 16
bmc: timeout 120
cover: mode cover
cover: depth 16
cover: timeout 120

[engines]
smtbmc z3

[script]
read_verilog -formal sync_fifo.v
read_verilog -formal fifo_props.v
prep -top fifo_props

[files]
../p2-sync-fifo/sync_fifo.v
fifo_props.v
